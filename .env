# ==============================================================================
# SOCIAL PULSE — Environment Configuration
# ==============================================================================

# Core Settings
ENVIRONMENT=development
LOG_LEVEL=INFO
SECRET_KEY=social-pulse-secret-key-change-in-production-min32chars
ALGORITHM=HS256
ACCESS_TOKEN_EXPIRE_MINUTES=1440

# Zero-Dummy-Data Enforcement:
# When DEMO_MODE=false, synthetic/fabricated data generation is strictly prohibited.
DEMO_MODE=false

# Database Configuration (PostgreSQL)
DATABASE_URL=postgresql://postgres:postgres@postgres:5432/social_pulse
# For local development outside Docker:
# DATABASE_URL=postgresql://postgres:postgres@localhost:5432/social_pulse

# Redis Job Queue & Cache
REDIS_URL=redis://redis:6379/0
# For local development outside Docker:
# REDIS_URL=redis://localhost:6379/0

# Backend & Frontend Endpoints
BACKEND_HOST=0.0.0.0
BACKEND_PORT=8000
FRONTEND_PORT=3000
VITE_API_URL=http://localhost:8000

# Social Media Platforms (Ingestion Architecture)
X_API_KEY=
X_API_SECRET=
X_ACCESS_TOKEN=

TELEGRAM_BOT_TOKEN=

INSTAGRAM_ACCESS_TOKEN=

FACEBOOK_ACCESS_TOKEN=

REDDIT_CLIENT_ID=
REDDIT_CLIENT_SECRET=

YOUTUBE_API_KEY=

# ML / NLP Model Configuration
MODEL_NAME=cardiffnlp/twitter-roberta-base-sentiment-latest
EMBEDDING_MODEL_NAME=sentence-transformers/all-MiniLM-L6-v2
